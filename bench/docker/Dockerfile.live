# Agent image: SWE-bench-Live's amd64 instance image + Node 22 + pinned Claude Code.
#
# Same recipe as Dockerfile (the arm64 Epoch images) with three differences:
#   * the base is passed whole as BASE, because the Live image name is the instance
#     id mangled ("__" -> "_1776_", lowercased), not the instance id itself;
#   * the x64 Node tarball, because these images are single-arch amd64 and run under
#     emulation on Apple Silicon -- always build with --platform linux/amd64;
#   * nothing else. The Live bases have a plain /usr/local/bin/python and no conda,
#     so there is no environment to activate.
#
# Build: bench/docker/build-live.sh <instance_id>
#   == docker build --platform linux/amd64 \
#        --build-arg BASE=starryzhang/sweb.eval.x86_64.<mangled id> \
#        -t harness-lab/agent.amd64.<instance_id> -f bench/docker/Dockerfile.live bench/docker
ARG BASE=starryzhang/sweb.eval.x86_64.joke2k_1776_faker-2190
FROM ${BASE}
ARG NODE_VERSION=22.20.0
ARG CLAUDE_VERSION=2.1.76
RUN set -eux; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz; \
    mkdir -p /opt/node; tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; rm /tmp/node.tar.xz
ENV PATH=/opt/node/bin:$PATH
# The driver runs the agent with `bash -lc` (bench/run.py). Debian's /etc/profile
# HARD-RESETS PATH for login shells, which drops the ENV above and makes `claude`
# and `node` unfound -- the Epoch arm64 bases get away without this because their
# conda layer already ships a profile.d snippet. Verified by running the image.
RUN mkdir -p /etc/profile.d && \
    printf '%s\n' 'PATH=/opt/node/bin:$PATH' 'export PATH' > /etc/profile.d/10-node.sh
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_VERSION}" && claude --version
RUN mkdir -p /harness /task/repro
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CLAUDE_CONFIG_DIR=/harness
WORKDIR /testbed
