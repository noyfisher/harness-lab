+def _split_regexp_csv(value: str) -> list[str]:
+    """Split a comma separated list of regular expressions.
+
+    Unlike a plain CSV split, this only splits on commas that are not
+    nested inside brackets/braces/parentheses, so that patterns
+    containing commas (e.g. quantifiers like ``{1,3}``) are preserved.
+    """
+    fields: list[str] = []
+    depth = 0
+    current: list[str] = []
+    for char in value:
+        if char in "([{":
+            depth += 1
+        elif char in ")]}":
+            depth = max(0, depth - 1)
+        if char == "," and depth == 0:
+            fields.append("".join(current).strip())
+            current = []
+        else:
+            current.append(char)
+    fields.append("".join(current).strip())
+    return [field for field in fields if field]
+
+
 def _regexp_csv_transfomer(value: str) -> Sequence[Pattern[str]]:
     """Transforms a comma separated list of regular expressions."""
     patterns: list[Pattern[str]] = []
-    for pattern in _csv_transformer(value):
+    for pattern in _split_regexp_csv(value):
         patterns.append(_regex_transformer(pattern))
     return patterns
 
