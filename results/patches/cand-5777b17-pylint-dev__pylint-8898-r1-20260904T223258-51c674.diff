+def _regexp_csv_transformer_split(value: str) -> Sequence[str]:
+    """Split a comma separated list of regular expressions, allowing a comma
+    to be included in a single regular expression by escaping it as ``\\,``.
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    stripped = (piece.strip() for piece in re.split(r"(?<!\\),", value))
+    return [piece.replace("\\,", ",") for piece in stripped if piece]
