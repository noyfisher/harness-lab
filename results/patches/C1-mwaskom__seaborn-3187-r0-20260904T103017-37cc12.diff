@@ -379,6 +379,15 @@ class ContinuousBase(Scale):
             locs = axis.major.locator()
             locs = locs[(vmin <= locs) & (locs <= vmax)]
             labels = axis.major.formatter.format_ticks(locs)
+            # Account for values that are formatted with a multiplicative
+            # offset (e.g. "1.0" for 1e6 with an implicit "1e6" scale) so
+            # that legend entries reflect the true magnitude of the data.
+            formatter = axis.major.formatter
+            if isinstance(formatter, mpl.ticker.ScalarFormatter) and formatter.get_offset():
+                labels = [
+                    formatter.format_data(loc) if loc != 0 else label
+                    for loc, label in zip(locs, labels)
+                ]
             new._legend = list(locs), list(labels)
 
         return new
