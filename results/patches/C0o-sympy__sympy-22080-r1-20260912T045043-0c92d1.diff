+    def parenthesize(self, item, level, strict=False):
+        if isinstance(item, Mod):
+            # ``Mod`` is printed with the ``%`` operator, which binds no
+            # tighter than a multiplication (and a ``-`` sign put in front of
+            # it by the caller binds even tighter), while ``precedence``
+            # reports the precedence of a function for it.  Brackets are
+            # therefore needed whenever it is an operand of another operator,
+            # e.g. ``-Mod(x, y)`` has to be printed as ``-(x % y)``.
+            if level >= PRECEDENCE["Add"]:
+                return "({})".format(self._print(item))
+        return super().parenthesize(item, level, strict)
+
     def _print_Mod(self, expr):
         PREC = precedence(expr)
         return ('{} % {}'.format(*map(lambda x: self.parenthesize(x, PREC), expr.args)))
