+def _splitstrip_regexp_csv(value: str) -> list[str]:
+    """Split a comma separated list of regular expressions, ignoring commas
+    that are nested inside `()`, `[]`, or `{}` (e.g. quantifiers such as
+    `{1,3}`), and discard empty/whitespace-only entries.
+    """
+    parts: list[str] = []
+    current: list[str] = []
+    depth = 0
+    for char in value:
+        if char in "([{":
+            depth += 1
+        elif char in ")]}":
+            depth = max(0, depth - 1)
+        if char == "," and depth == 0:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    parts.append("".join(current))
+    return [part.strip() for part in parts if part.strip()]
+
