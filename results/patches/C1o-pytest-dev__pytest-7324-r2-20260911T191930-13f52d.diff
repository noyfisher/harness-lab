+# Used to prefix ident tokens when building the ast.Name nodes below, in order
+# to avoid the identifiers "True", "False" and "None" being interpreted as
+# their corresponding ast.NameConstant nodes by the Python compiler (the
+# regex used by the scanner cannot produce a "$" so there is no ambiguity).
+IDENT_PREFIX = "$"
+
+
 class TokenType(enum.Enum):
     LPAREN = "left parenthesis"
     RPAREN = "right parenthesis"
