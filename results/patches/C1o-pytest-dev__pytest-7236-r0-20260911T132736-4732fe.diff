diff --git a/changelog/7215.bugfix.rst b/changelog/7215.bugfix.rst
new file mode 100644
index 0000000..49f7128
--- /dev/null
+++ b/changelog/7215.bugfix.rst
@@ -0,0 +1 @@
+Fix ``--pdb`` erroneously calling ``tearDown()`` on ``unittest.TestCase`` tests that are skipped (via ``@unittest.skip`` on the method or the class).
diff --git a/src/_pytest/unittest.py b/src/_pytest/unittest.py
index 773f545..7c2616a 100644
--- a/src/_pytest/unittest.py
+++ b/src/_pytest/unittest.py
@@ -220,7 +220,8 @@ class TestCaseFunction(Function):
             # arguably we could always postpone tearDown(), but this changes the moment where the
             # TestCase instance interacts with the results object, so better to only do it
             # when absolutely needed
-            if self.config.getoption("usepdb"):
+            skipped = _is_skipped(self.obj) or _is_skipped(self._testcase)
+            if self.config.getoption("usepdb") and not skipped:
                 self._explicit_tearDown = self._testcase.tearDown
                 setattr(self._testcase, "tearDown", lambda *args: None)
 
@@ -301,3 +302,8 @@ def check_testcase_implements_trial_reporter(done=[]):
 
     classImplements(TestCaseFunction, IReporter)
     done.append(1)
+
+
+def _is_skipped(obj) -> bool:
+    """Return True if the given object has been marked with @unittest.skip"""
+    return bool(getattr(obj, "__unittest_skip__", False))
