+def _regexp_csv_split(value: str) -> list[str]:
+    """Split a comma separated list of regular expressions, ignoring commas that
+    are nested inside brackets (e.g. the comma in the quantifier of
+    ``(foo{1,3})``), and discarding empty fragments after stripping whitespace.
+    """
+    if isinstance(value, (list, tuple)):
+        return list(value)
+    fragments: list[str] = []
+    current: list[str] = []
+    depth = 0
+    for char in value:
+        if char in "([{":
+            depth += 1
+        elif char in ")]}":
+            depth = max(0, depth - 1)
+        if char == "," and depth == 0:
+            fragments.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    fragments.append("".join(current))
+    return [fragment.strip() for fragment in fragments if fragment.strip()]
+
