+def _splitstrip_regexp_csv(value: str) -> list[str]:
+    """Split a comma separated list of regular expressions.
+
+    Commas inside curly-brace quantifiers (e.g. ``{1,3}``) are not treated
+    as separators, so a single regular expression containing a quantifier
+    is not mangled into invalid fragments.
+    """
+    parts: list[str] = []
+    current: list[str] = []
+    depth = 0
+    for char in value:
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth = max(depth - 1, 0)
+        if char == "," and depth == 0:
+            parts.append("".join(current).strip())
+            current = []
+        else:
+            current.append(char)
+    parts.append("".join(current).strip())
+    return [part for part in parts if part]
+
+
 def _regexp_csv_transfomer(value: str) -> Sequence[Pattern[str]]:
     """Transforms a comma separated list of regular expressions."""
     patterns: list[Pattern[str]] = []
-    for pattern in _csv_transformer(value):
+    for pattern in _splitstrip_regexp_csv(value):
