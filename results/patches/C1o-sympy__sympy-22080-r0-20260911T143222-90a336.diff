+    def parenthesize(self, item, level, strict=False):
+        if isinstance(item, Mod) and type(self)._print_Mod is AbstractPythonCodePrinter._print_Mod:
+            # Mod is printed above with the ``%`` operator, which binds
+            # like ``*`` in Python, not like a function call. Add's level
+            # is used rather than Mul's because _print_Mul() parenthesizes
+            # the factors of a negative Mul at precedence(Mul) == Add
+            # before prefixing them with ``-``, and ``-x % y`` means
+            # ``(-x) % y`` in Python. Printers that render Mod as a
+            # function call instead (NumPyPrinter) are excluded above.
+            prec = PRECEDENCE["Add"]
+            if (prec < level) or ((not strict) and prec <= level):
+                return "(%s)" % self._print(item)
+            else:
+                return self._print(item)
+        return super().parenthesize(item, level, strict=strict)
