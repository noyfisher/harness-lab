+# Prefix for the ast.Name id built from a scanned identifier. This char can
+# never appear in a scanned ident (see the Scanner regex below), so
+# prefixing guarantees the ast.Name id is never exactly "True", "False" or
+# "None" -- which the Python compiler forbids for ast.Name nodes -- while
+# still allowing those words to be used as -k/-m expression identifiers.
+IDENT_PREFIX = "$"
+
+
 class TokenType(enum.Enum):
     LPAREN = "left parenthesis"
     RPAREN = "right parenthesis"
@@ -161,7 +169,7 @@ def not_expr(s: Scanner) -> ast.expr:
         return ret
     ident = s.accept(TokenType.IDENT)
     if ident:
-        return ast.Name(ident.value, ast.Load())
+        return ast.Name(IDENT_PREFIX + ident.value, ast.Load())
     s.reject((TokenType.NOT, TokenType.LPAREN, TokenType.IDENT))
 
 
@@ -172,7 +180,7 @@ class MatcherAdapter(Mapping[str, bool]):
         self.matcher = matcher
 
     def __getitem__(self, key: str) -> bool:
-        return self.matcher(key)
+        return self.matcher(key[len(IDENT_PREFIX) :])
 
