+def _splitstrip_regexp_csv(value: str) -> list[str]:
+    """Split a comma-separated list of regular expressions.
+
+    Unlike a plain comma-separated list, a comma may be included in one of
+    the regular expressions by escaping it with a backslash (``\\,``), which
+    allows patterns containing a literal comma (e.g. inside a ``{m,n}``
+    repetition) to be expressed.
+    """
+    return [
+        chunk.strip().replace("\\,", ",")
+        for chunk in re.split(r"(?<!\\),", value)
+        if chunk.strip()
+    ]
+
