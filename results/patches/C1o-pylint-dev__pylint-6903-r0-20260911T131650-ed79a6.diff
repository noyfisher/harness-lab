--- a/pylint/lint/run.py
+++ b/pylint/lint/run.py
@@ -58,6 +58,12 @@ def _query_cpu() -> int | None:
             cpu_shares = int(file.read().rstrip())
         # For AWS, gives correct value * 1024.
         avail_cpu = int(cpu_shares / 1024)
+    # In K8s Pods the number of cpu shares is rounded down to the closest
+    # integer number of CPUs. This means that a pod can have a fraction of
+    # a CPU allotted and avail_cpu will be 0. Since we cannot run a fraction
+    # of a process, we default to 1 in this case.
+    if avail_cpu == 0:
+        avail_cpu = 1
     return avail_cpu
 
 
