+    def parenthesize(self, item, level, strict=False):
+        if isinstance(item, Mod):
+            # Mod is printed using the Python ``%`` operator, which has the
+            # precedence of a multiplication and binds less tightly than a
+            # unary minus, rather than the function-like precedence SymPy
+            # assigns to Mod.
+            prec = PRECEDENCE["Add"]
+            if (prec < level) or ((not strict) and prec <= level):
+                return "(%s)" % self._print(item)
+            return self._print(item)
+        return super().parenthesize(item, level, strict=strict)
+
     def _print_Mod(self, expr):
         PREC = precedence(expr)
         return ('{} % {}'.format(*map(lambda x: self.parenthesize(x, PREC), expr.args)))
