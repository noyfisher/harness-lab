+def _regex_csv_split(value: str) -> list[str]:
+    """Split a comma separated list of regular expressions.
+
+    Commas inside a quantifier (e.g. the ``1,3`` in ``foo{1,3}``) are part of
+    a single regular expression and must not be treated as separators.
+    """
+    result: list[str] = []
+    current = ""
+    depth = 0
+    for char in value:
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth = max(depth - 1, 0)
+        if char == "," and depth == 0:
+            result.append(current.strip())
+            current = ""
+        else:
+            current += char
+    result.append(current.strip())
+    return [item for item in result if item]
+
