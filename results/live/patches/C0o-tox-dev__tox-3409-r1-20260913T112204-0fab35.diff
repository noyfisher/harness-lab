+def dependency_groups(root: Path, groups: set[str]) -> set[Requirement]:
+    """
+    Resolve a set of :pep:`735` dependency groups into requirements.
+
+    :param root: the folder containing the ``pyproject.toml`` defining the groups
+    :param groups: the group names to resolve
+    :return: the set of requirements the groups expand to
+    """
+    py_project_file = root / "pyproject.toml"
+    if not py_project_file.exists():
+        msg = f"{py_project_file} does not exist"
+        raise Fail(msg)
+    with py_project_file.open("rb") as file_handler:
+        py_project = tomllib.load(file_handler)
+    groups_raw: dict[str, Any] = py_project.get("dependency-groups", {})
+    if not isinstance(groups_raw, dict):
+        msg = f"dependency-groups table found in {py_project_file} is not a table"
+        raise Fail(msg)
+    normalized: dict[str, Any] = {}
+    for name, value in groups_raw.items():
+        normalized_name = _normalize_group_name(name)
+        if normalized_name in normalized:
+            msg = f"duplicate dependency group name {normalized_name} in {py_project_file}"
+            raise Fail(msg)
+        normalized[normalized_name] = value
+    result: set[Requirement] = set()
+    for group in groups:
+        result.update(_resolve_dependency_group(py_project_file, normalized, _normalize_group_name(group)))
+    return result
+
+
+def _normalize_group_name(name: str) -> str:
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def _resolve_dependency_group(
+    py_project_file: Path, groups: dict[str, Any], group: str, past_groups: tuple[str, ...] = ()
+) -> set[Requirement]:
+    if group in past_groups:
+        msg = f"cyclic dependency group include: {group} -> {past_groups}"
+        raise Fail(msg)
+    if group not in groups:
+        msg = f"dependency group {group!r} not found in {py_project_file}"
+        raise Fail(msg)
+    raw_group = groups[group]
+    if not isinstance(raw_group, list):
+        msg = f"dependency group {group!r} is not a list"
+        raise Fail(msg)
+
+    result: set[Requirement] = set()
+    for item in raw_group:
+        if isinstance(item, str):
+            try:
+                result.add(Requirement(item))
+            except InvalidRequirement as exc:
+                msg = f"{item!r} is not valid requirement due to {exc}"
+                raise Fail(msg) from exc
+        elif isinstance(item, dict) and tuple(item.keys()) == ("include-group",):
+            include_group = _normalize_group_name(next(iter(item.values())))
+            result.update(_resolve_dependency_group(py_project_file, groups, include_group, (*past_groups, group)))
+        else:
+            msg = f"invalid dependency group item: {item!r}"
+            raise Fail(msg)
+    return result
+
+
