+    def _normalize_group(self, group: str) -> str:
+        """Map a user-given group name to the name used by the project, comparing them in
+        their normalized forms. See https://peps.python.org/pep-0735/#specification
+        """
+        if group.startswith(":"):  # special selectors like ":all"
+            return group
+        group_map = {normalize_name(g): g for g in self.project.iter_groups()}
+        return group_map.get(normalize_name(group), group)
