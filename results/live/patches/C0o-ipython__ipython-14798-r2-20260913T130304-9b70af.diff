+_cell_magic_assign_re = re.compile(
+    r"\s*(?P<target>[A-Za-z_]\w*(?:\s*\.\s*[A-Za-z_]\w*|\s*\[[^\]]*\])*)\s*=\s*(?=%%)"
+)
+
+
+def _cell_magic_start(line: str) -> Optional[Tuple[str, str]]:
+    """Split the first line of a cell into an assignment target and a cell magic.
+
+    Returns a ``(target, magic)`` tuple, where *target* is the empty string if
+    the cell magic is not assigned to anything, or None if *line* does not
+    start a cell magic.
+    """
+    if line.startswith("%%"):
+        return "", line
+    match = _cell_magic_assign_re.match(line)
+    if match is None:
+        return None
+    return match.group("target"), line[match.end() :]
+
