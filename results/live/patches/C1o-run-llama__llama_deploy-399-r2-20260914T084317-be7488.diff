+    @staticmethod
+    def _set_environment_variables(
+        service_config: Service, root: Path | None = None
+    ) -> None:
+        """Sets the environment variables for the service, from `env` and `env-files` in the service configuration."""
+        env_vars: dict[str, str | None] = {}
+
+        if service_config.env:
+            env_vars.update(service_config.env)
+
+        if service_config.env_files:
+            for env_file in service_config.env_files:
+                path = Path(root) / env_file if root is not None else Path(env_file)
+                env_vars.update(dotenv_values(path))
+
+        for key, value in env_vars.items():
+            if value:
+                os.environ[key] = value
