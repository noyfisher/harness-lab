+            return self._fold_group_name(self.groups[0])
         return "dev" if self.dev else "default"
 
+    def _fold_group_name(self, name: str) -> str:
+        """Fold a raw group name to its normalized spelling if it refers to an
+        existing dev-dependencies group, leaving known groups (``default``,
+        optional-dependencies keys, ``:all``) and unknown names untouched."""
+        project = self.project
+        optional_groups = set(project.pyproject.metadata.get("optional-dependencies", {}))
+        dev_groups = set(project.pyproject.dev_dependencies)
+        known_groups = optional_groups | dev_groups | {"default", ":all"}
+        if name in known_groups:
+            return name
+        normalized = normalize_name(name)
+        return normalized if normalized in dev_groups else name
+
     @property
     def is_unset(self) -> bool:
         return self.default and self.dev is None and not self.groups
