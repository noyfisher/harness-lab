+    def _normalize_group(self, group: str) -> str:
+        """Map a user-given group name to the group name used by the project.
+
+        Dependency group names are normalized(PEP 735) when read from the pyproject.toml,
+        so a name given on the command line must be normalized before comparing as well.
+        """
+        from pdm.utils import normalize_name
+
+        if group.startswith(":"):  # special selectors like `:all`
+            return group
+        project_groups = set(self.project.iter_groups())
+        if group in project_groups:
+            return group
+        normalized = normalize_name(group)
+        return normalized if normalized in project_groups else group
+
