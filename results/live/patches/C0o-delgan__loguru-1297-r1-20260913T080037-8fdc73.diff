+def _utc_offset_seconds(timestamp):
+    utc_naive = datetime_.fromtimestamp(timestamp, tz=timezone.utc).replace(tzinfo=None)
+    offset = datetime_.fromtimestamp(timestamp) - utc_naive
+    return offset.total_seconds()
