-        utc_naive = datetime_.fromtimestamp(timestamp, tz=timezone.utc).replace(tzinfo=None)
-        offset = datetime_.fromtimestamp(timestamp) - utc_naive
-        seconds = offset.total_seconds()
+        seconds = _utc_offset_seconds(timestamp)
         zone = strftime("%Z")
 
+    if abs(seconds) >= 86400:
+        # On some platforms (notably Windows), the "tm_gmtoff" value is computed from an
