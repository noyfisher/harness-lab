+def dependency_groups_to_deps(groups: Mapping[str, Any], names: Iterable[str]) -> list[Requirement]:
+    """
+    Resolve PEP-735 dependency groups into a list of requirements.
+
+    :param groups: the content of the ``dependency-groups`` table
+    :param names: the dependency group names to resolve
+    :return: the requirements of the selected groups (with the included groups expanded)
+    """
+    by_name: dict[str, Any] = {}
+    for name, value in groups.items():
+        key = canonicalize_name(name)
+        if key in by_name:
+            msg = f"duplicate dependency group name {key}"
+            raise Fail(msg)
+        by_name[key] = value
+    result: list[Requirement] = []
+    done: set[str] = set()
+    for name in names:
+        _resolve_dependency_group(by_name, canonicalize_name(name), [], done, result)
+    return result
+
+
+def _resolve_dependency_group(
+    groups: Mapping[str, Any],
+    name: str,
+    path: list[str],
+    done: set[str],
+    result: list[Requirement],
+) -> None:
+    if name in path:
+        msg = f"cyclic dependency group include {' -> '.join([*path, name])}"
+        raise Fail(msg)
+    if name not in groups:
+        msg = f"dependency group {name} not found, available groups are {', '.join(sorted(groups)) or 'none'}"
+        raise Fail(msg)
+    if name in done:
+        return
+    done.add(name)
+    entries = groups[name]
+    if not isinstance(entries, list):
+        msg = f"dependency group {name} is not a list"
+        raise Fail(msg)
+    for entry in entries:
+        if isinstance(entry, str):
+            try:
+                result.append(Requirement(entry))
+            except InvalidRequirement as exc:
+                msg = f"{entry} is not a valid requirement in dependency group {name}: {exc}"
+                raise Fail(msg) from exc
+        elif isinstance(entry, dict) and set(entry) == {"include-group"} and isinstance(entry["include-group"], str):
+            _resolve_dependency_group(groups, canonicalize_name(entry["include-group"]), [*path, name], done, result)
+        else:
+            msg = f"invalid dependency group item {entry!r} in dependency group {name}"
+            raise Fail(msg)
+
+
 __all__ = [
     "PythonRun",
     "add_extras_to_env",
     "add_skip_missing_interpreters_to_core",
+    "dependency_groups_to_deps",
 ]
