diff --git a/haystack/components/converters/utils.py b/haystack/components/converters/utils.py
index 87cd143..b000242 100644
--- a/haystack/components/converters/utils.py
+++ b/haystack/components/converters/utils.py
@@ -6,6 +6,10 @@ from pathlib import Path
 from typing import Any, Dict, List, Optional, Union
 
 from haystack.dataclasses import ByteStream
+from haystack.lazy_imports import LazyImport
+
+with LazyImport("Run 'pip install chardet'") as chardet_import:
+    import chardet
 
 
 def get_bytestream_from_source(source: Union[str, Path, ByteStream]) -> ByteStream:
@@ -49,3 +53,35 @@ def normalize_metadata(
             raise ValueError("The length of the metadata list must match the number of sources.")
         return meta
     raise ValueError("meta must be either None, a dictionary or a list of dictionaries.")
+
+
+def normalize_encoding(text: str, encoding: str = "utf-8") -> str:
+    """
+    Normalize the encoding of a text extracted from a PDF.
+
+    Some PDF libraries decode text using the wrong single-byte codec, producing mojibake.
+    This function re-decodes such text using the correct codec, either explicitly provided
+    or automatically detected with `chardet`.
+
+    :param text: the text to normalize.
+    :param encoding: the codec to use to re-decode `text`. If `"auto"`, the codec is detected
+        automatically with `chardet`. Defaults to `"utf-8"`, which assumes `text` is already correct
+        and returns it unchanged.
+    :returns: the text, normalized to proper unicode.
+    """
+    if not text or encoding == "utf-8":
+        return text
+
+    if any(ord(c) > 0xFF for c in text):
+        # The text already contains proper unicode characters, so it was not mis-decoded.
+        return text
+
+    raw = text.encode("latin-1")
+
+    codec = encoding
+    if encoding == "auto":
+        chardet_import.check()
+        detected = chardet.detect(raw)["encoding"]
+        codec = detected or "utf-8"
+
+    return raw.decode(codec, errors="replace")
