+# Matches a simple `name = ` prefix (no dotted/subscript targets, no chained
+# assignment) immediately followed by `%%`, e.g. the `elapsed = ` in
+# `elapsed = %%timeit`. Mirrors the single-target limitation of MagicAssign
+# below ("We don't try to support multiple special assignment").
+_cell_magic_assign_re = re.compile(r'^(?P<target>[A-Za-z_]\w*)[ \t]*=[ \t]*(?=%%)')
+
+
+def _cell_magic_target_and_rest(line):
+    """Check whether `line` starts a cell magic, optionally prefixed by a
+    simple ``name = `` assignment target.
+
+    Returns ``(target, rest)`` where ``rest`` is the part of the line
+    starting at ``%%`` and ``target`` is the assignment target name, or
+    ``None`` if the target is not present. Returns ``None`` (not a tuple) if
+    `line` is not a cell magic line at all.
+    """
+    m = _cell_magic_assign_re.match(line)
+    if m:
+        target, rest = m.group('target'), line[m.end():]
+    else:
+        target, rest = None, line
+    if not rest.startswith('%%'):
+        return None
+    return target, rest
+
+
