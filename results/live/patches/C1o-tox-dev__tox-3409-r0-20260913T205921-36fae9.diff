--- /dev/null
+++ b/src/tox/tox_env/python/dependency_groups.py
@@ -0,0 +1,73 @@
+"""Resolve PEP 735 dependency groups from a ``pyproject.toml`` file."""
+
+from __future__ import annotations
+
+import sys
+from typing import TYPE_CHECKING, Any
+
+from packaging.requirements import Requirement
+from packaging.utils import canonicalize_name
+
+from tox.report import HandledError
+
+if sys.version_info >= (3, 11):  # pragma: no cover (py311+)
+    import tomllib
+else:  # pragma: no cover (py311+)
+    import tomli as tomllib
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+
+def resolve(root: Path, groups: set[str]) -> set[Requirement]:
+    """Resolve the given PEP 735 dependency group names to a flat set of requirements."""
+    pyproject_toml = root / "pyproject.toml"
+    if not pyproject_toml.exists():
+        msg = f"{pyproject_toml} does not exist, cannot resolve dependency groups {sorted(groups)}"
+        raise HandledError(msg)
+    with pyproject_toml.open("rb") as file_handler:
+        content = tomllib.load(file_handler)
+    dependency_groups = content.get("dependency-groups")
+    if not isinstance(dependency_groups, dict):
+        msg = f"{pyproject_toml} has no [dependency-groups] table"
+        raise HandledError(msg)
+    normalized = {canonicalize_name(k): v for k, v in dependency_groups.items()}
+    result: set[Requirement] = set()
+    for group in groups:
+        result |= _resolve_group(canonicalize_name(group), normalized, pyproject_toml, [])
+    return result
+
+
+def _resolve_group(
+    group: str,
+    dependency_groups: dict[str, Any],
+    pyproject_toml: Path,
+    chain: list[str],
+) -> set[Requirement]:
+    if group in chain:
+        cycle = " -> ".join([*chain, group])
+        msg = f"cyclic dependency group include in {pyproject_toml}: {cycle}"
+        raise HandledError(msg)
+    if group not in dependency_groups:
+        msg = f"dependency group {group!r} not found in {pyproject_toml}"
+        raise HandledError(msg)
+    items = dependency_groups[group]
+    if not isinstance(items, list):
+        msg = f"dependency group {group!r} in {pyproject_toml} must be a list, got {items!r}"
+        raise HandledError(msg)
+    result: set[Requirement] = set()
+    for item in items:
+        if isinstance(item, str):
+            result.add(Requirement(item))
+        elif isinstance(item, dict) and set(item) == {"include-group"}:
+            included = canonicalize_name(item["include-group"])
+            result |= _resolve_group(included, dependency_groups, pyproject_toml, [*chain, group])
+        else:
+            msg = f"invalid dependency group item in group {group!r} of {pyproject_toml}: {item!r}"
+            raise HandledError(msg)
+    return result
+
+
+__all__ = [
+    "resolve",
+]
