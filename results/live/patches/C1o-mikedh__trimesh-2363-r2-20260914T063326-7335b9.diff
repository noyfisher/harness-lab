+def _shape_to_path_string(tag, attrib):
+    """
+    Convert an SVG basic-shape element's attributes into an
+    equivalent SVG path `d` string so it can be run through the
+    same `_svg_path_convert` pipeline as a `<path>` element.
+
+    Parameters
+    ------------
+    tag : str
+      Local tag name, e.g. 'rect', 'circle', etc.
+    attrib : dict
+      Element attributes.
+
+    Returns
+    ------------
+    d : str or None
+      Equivalent path string, or None if the shape is
+      degenerate (zero size) and should be skipped.
+    """
+
+    def num(key, default=0.0):
+        # missing attributes default to 0 per the SVG spec
+        try:
+            return float(attrib.get(key, default))
+        except (TypeError, ValueError):
+            log.debug(f"unparseable SVG attribute `{key}`={attrib.get(key)!r}")
+            return default
+
+    if tag == "line":
+        return f"M {num('x1')},{num('y1')} L {num('x2')},{num('y2')}"
+    elif tag in ("polyline", "polygon"):
+        values = [float(v) for v in _num_re.findall(attrib.get("points", ""))]
+        if len(values) < 4:
+            return None
+        points = zip(values[0::2], values[1::2])
+        d = "M " + " L ".join(f"{x},{y}" for x, y in points)
+        return d + " Z" if tag == "polygon" else d
+    elif tag == "rect":
+        x, y, width, height = num("x"), num("y"), num("width"), num("height")
+        if width <= 0 or height <= 0:
+            return None
+        # unparseable or negative rx/ry are "unset" per the SVG spec
+        rx, ry = num("rx", None), num("ry", None)
+        rx = None if rx is not None and rx < 0 else rx
+        ry = None if ry is not None and ry < 0 else ry
+        if rx is not None or ry is not None:
+            rx = rx if rx is not None else ry
+            ry = ry if ry is not None else rx
+            rx = min(rx, width / 2.0)
+            ry = min(ry, height / 2.0)
+        if rx and ry and rx > 0 and ry > 0:
+            return (
+                f"M {x + rx},{y} "
+                + f"H {x + width - rx} "
+                + f"A {rx},{ry} 0 0 1 {x + width},{y + ry} "
+                + f"V {y + height - ry} "
+                + f"A {rx},{ry} 0 0 1 {x + width - rx},{y + height} "
+                + f"H {x + rx} "
