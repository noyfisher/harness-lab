+# SPDX-FileCopyrightText: 2022-present deepset GmbH <info@deepset.ai>
+#
+# SPDX-License-Identifier: Apache-2.0
+
+from io import StringIO
+from typing import Dict, List, Literal, Optional, Tuple
+
+from haystack import Document, component, logging
+from haystack.lazy_imports import LazyImport
+
+with LazyImport("Run 'pip install pandas'") as pandas_import:
+    import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+
+@component
+class CSVDocumentSplitter:
+    """
+    A component for splitting CSV documents into sub-tables based on split criteria.
+
+    This component splits a CSV document into multiple sub-tables by identifying blocks of rows and/or
+    columns that are separated by a specified number of consecutive empty rows and/or columns.
+
+    ### Usage example
+
+    ```python
+    from haystack import Document
+    from haystack.components.preprocessors.csv_document_splitter import CSVDocumentSplitter
+
+    splitter = CSVDocumentSplitter()
+    doc = Document(content="A,B\\n1,2\\n\\n\\nX,Y\\n3,4\\n")
+    result = splitter.run(documents=[doc])
+    docs = result["documents"]
+    ```
+    """
+
+    def __init__(self, row_split_threshold: Optional[int] = 2, column_split_threshold: Optional[int] = 2) -> None:
+        """
+        Initializes the CSVDocumentSplitter component.
+
+        :param row_split_threshold: The minimum number of consecutive empty rows required to trigger a split
+            in the row direction. If set to `None`, splitting will be based only on columns.
+        :param column_split_threshold: The minimum number of consecutive empty columns required to trigger a
+            split in the column direction. If set to `None`, splitting will be based only on rows.
+
+        :raises ValueError: If `row_split_threshold` is not greater than 0 (when provided).
+        :raises ValueError: If `column_split_threshold` is not greater than 0 (when provided).
+        :raises ValueError: If both `row_split_threshold` and `column_split_threshold` are `None`.
+        """
+        pandas_import.check()
+
+        if row_split_threshold is not None and row_split_threshold < 1:
+            raise ValueError("row_split_threshold must be greater than 0")
+
+        if column_split_threshold is not None and column_split_threshold < 1:
+            raise ValueError("column_split_threshold must be greater than 0")
+
+        if row_split_threshold is None and column_split_threshold is None:
+            raise ValueError("At least one of row_split_threshold or column_split_threshold must be specified.")
+
+        self.row_split_threshold = row_split_threshold
+        self.column_split_threshold = column_split_threshold
+
+    @component.output_types(documents=List[Document])
+    def run(self, documents: List[Document]) -> Dict[str, List[Document]]:
+        """
+        Processes and splits a list of CSV documents into multiple sub-tables.
+
+        **Splitting Process:**
+        1. Applies a row-based split if `row_split_threshold` is provided.
+        2. Applies a column-based split if `column_split_threshold` is provided.
+        3. If both thresholds are provided, performs a recursive split by rows first, then columns, ensuring
+           further splitting of any sub-tables that still contain empty sections.
+
+        :param documents: A list of Documents containing CSV-formatted content. Each document is assumed to
+            contain one or more tables separated by empty rows or columns.
+
+        :return: A dictionary with a key `"documents"`, mapping to a list of new `Document` objects, each
+            representing an extracted sub-table from the original CSV. The metadata of each new document
+            includes:
+            - A `source_id` field linking back to the original document's ID.
+            - All other metadata inherited from the original document.
+
+        :raises RuntimeError: If pandas is not installed.
+        """
+        if not documents:
+            return {"documents": documents}
+
+        split_documents = []
+        for document in documents:
+            if document.content is None:
+                logger.warning("Document {doc_id} has no content, skipping it.", doc_id=document.id)
+                split_documents.append(document)
+                continue
+
+            try:
+                df = pd.read_csv(StringIO(document.content), header=None, skip_blank_lines=False, dtype=object)
+            except Exception as e:
+                logger.error(
+                    "Error processing document {doc_id}. Keeping it, but skipping splitting. Error: {error}",
+                    doc_id=document.id,
+                    error=e,
+                )
+                split_documents.append(document)
+                continue
+
+            if self.row_split_threshold is not None and self.column_split_threshold is None:
+                split_dfs = self._split_dataframe(df=df, split_threshold=self.row_split_threshold, axis="row")
+            elif self.column_split_threshold is not None and self.row_split_threshold is None:
+                split_dfs = self._split_dataframe(df=df, split_threshold=self.column_split_threshold, axis="column")
+            else:
+                split_dfs = self._recursive_split(
+                    df=df,
+                    row_split_threshold=self.row_split_threshold,  # type: ignore[arg-type]
+                    column_split_threshold=self.column_split_threshold,  # type: ignore[arg-type]
+                )
+
+            for split_df in split_dfs:
+                split_documents.append(
+                    Document(
+                        content=split_df.to_csv(index=False, header=False, lineterminator="\n"),
+                        meta={**document.meta.copy(), "source_id": document.id},
+                    )
+                )
+
+        return {"documents": split_documents}
+
+    def _find_split_indices(
+        self, df: "pd.DataFrame", split_threshold: int, axis: Literal["row", "column"]
+    ) -> List[Tuple[int, int]]:
+        """
+        Finds the indices of consecutive empty rows or columns in a DataFrame that meet a split threshold.
+
+        :param df: DataFrame to split.
+        :param split_threshold: Minimum number of consecutive empty rows or columns to trigger a split.
+        :param axis: Determines whether to split on rows or columns.
+        """
+        if axis == "row":
+            empty_elements = df[df.isnull().all(axis=1)].index.tolist()
+        else:
+            empty_elements = df.columns[df.isnull().all(axis=0)].tolist()
+
+        # Identify groups of consecutive empty elements
+        split_indices: List[Tuple[int, int]] = []
+        if not empty_elements:
+            return split_indices
+
+        start_idx = empty_elements[0]
+        prev_idx = empty_elements[0]
+
+        for idx in empty_elements[1:]:
+            if idx == prev_idx + 1:
+                prev_idx = idx
+                continue
+            if prev_idx - start_idx + 1 >= split_threshold:
+                split_indices.append((start_idx, prev_idx))
+            start_idx = idx
+            prev_idx = idx
+
+        # Handle the last group
+        if prev_idx - start_idx + 1 >= split_threshold:
+            split_indices.append((start_idx, prev_idx))
+
+        return split_indices
+
+    def _split_dataframe(
+        self, df: "pd.DataFrame", split_threshold: int, axis: Literal["row", "column"]
+    ) -> List["pd.DataFrame"]:
+        """
+        Splits a DataFrame into sub-tables based on consecutive empty rows or columns exceeding a threshold.
+
+        :param df: DataFrame to split.
+        :param split_threshold: Minimum number of consecutive empty rows or columns to trigger a split.
+        :param axis: Determines whether to split on rows or columns.
+        """
+        # Find indices of consecutive empty rows or columns
+        split_indices = self._find_split_indices(df=df, split_threshold=split_threshold, axis=axis)
+
+        # If no split_indices are found, return the original DataFrame
+        if len(split_indices) == 0:
+            return [df]
+
+        sub_tables = []
+        table_start_idx = 0
+        df_length = df.shape[0] if axis == "row" else df.shape[1]
+
+        # Iterate over the split indices and create sub-tables
+        for empty_start_idx, empty_end_idx in split_indices + [(df_length, df_length)]:
+            if axis == "row":
+                sub_table = df.iloc[table_start_idx:empty_start_idx]
+            else:
+                sub_table = df.iloc[:, table_start_idx:empty_start_idx]
+            if not sub_table.empty:
+                sub_tables.append(sub_table)
+            table_start_idx = empty_end_idx + 1
+
+        return sub_tables
+
+    def _recursive_split(
+        self, df: "pd.DataFrame", row_split_threshold: int, column_split_threshold: int
+    ) -> List["pd.DataFrame"]:
+        """
+        Recursively splits a DataFrame.
+
+        Splits by rows first, then columns, until no more splits can happen based on row and column
+        thresholds.
+
+        :param df: A Pandas DataFrame to split.
+        :param row_split_threshold: The minimum number of consecutive empty rows to trigger a split.
+        :param column_split_threshold: The minimum number of consecutive empty columns to trigger a split.
+        """
+        # Split by rows first
+        new_sub_tables = self._split_dataframe(df=df, split_threshold=row_split_threshold, axis="row")
+
+        # Then split by columns
+        final_tables = []
+        for table in new_sub_tables:
+            final_tables.extend(self._split_dataframe(df=table, split_threshold=column_split_threshold, axis="column"))
+
+        # If no further splits were made, return the final tables
+        if len(final_tables) == 1 and final_tables[0].equals(df):
+            return final_tables
+
+        # Recursively split by rows and columns on the final tables
+        result = []
+        for table in final_tables:
+            result.extend(
+                self._recursive_split(
+                    df=table, row_split_threshold=row_split_threshold, column_split_threshold=column_split_threshold
+                )
+            )
+
+        return result
