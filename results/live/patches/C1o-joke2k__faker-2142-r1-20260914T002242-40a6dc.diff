+
+    def bban(self) -> str:
+        """Generate a Belgian Basic Bank Account Number (BBAN).
+
+        A Belgian BBAN is 12 digits: a 10-digit base followed by a 2-digit
+        national check number equal to ``int(base) % 97``, with a remainder
+        of 0 represented as 97.
+        """
+        base = super().bban()
+        check = int(base) % 97 or 97
+        return f"{base}{check:02d}"
