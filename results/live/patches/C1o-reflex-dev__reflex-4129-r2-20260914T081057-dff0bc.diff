+    @classmethod
+    def _handle_local_def(cls):
+        """Save a reference to a locally-defined state class in its own module.
+
+        Pickle resolves a class as `getattr(sys.modules[__module__], __qualname__)`,
+        which fails for classes defined inside a function, since their
+        `__qualname__` contains "<locals>". Exposing the class as a top-level
+        attribute of its defining module under a non-local name makes it
+        resolvable again.
+        """
+        module = sys.modules.get(cls.__module__)
+        if module is None:
+            return
+        name = cls.__name__
+        suffix = 0
+        while getattr(module, name, cls) is not cls:
+            suffix += 1
+            name = f"{cls.__name__}_{suffix}"
+        setattr(module, name, cls)
+        cls.__qualname__ = name
+
