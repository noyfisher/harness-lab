+    def _decode_text(self, text: str) -> str:
+        """
+        Re-decodes text that pdfminer decoded with the wrong encoding.
+
+        The characters extracted by pdfminer map one-to-one to the original bytes only when they all
+        fit in a single byte, so the conversion is skipped for text that already contains proper
+        Unicode. If the bytes cannot be decoded with the configured encoding the text is left as is.
+
+        :param text:
+            The text extracted by pdfminer.
+
+        :returns:
+            The text converted to UTF-8.
+        """
+        if not text:
+            return text
+
+        for source_encoding in ("cp1252", "latin-1"):
+            try:
+                raw = text.encode(source_encoding)
+                break
+            except UnicodeEncodeError:
+                continue
+        else:
+            # The text contains characters outside the single byte range, so it was decoded correctly.
+            return text
+
+        encoding = self.encoding
+        if encoding == "auto":
+            chardet_import.check()
+            encoding = chardet.detect(raw)["encoding"]
+            if not encoding:
+                return text
+
+        try:
+            return raw.decode(encoding)
+        except (UnicodeDecodeError, LookupError):
+            logger.warning(
+                "Could not decode the text extracted from the PDF using the encoding {encoding}. "
+                "Keeping the text as extracted.",
+                encoding=encoding,
+            )
+            return text
 
