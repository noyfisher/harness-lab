+    @classmethod
+    def _handle_local_def(cls):
+        """Handle locally-defined states for pickling."""
+        # Compute the name while the class still has its original module, so
+        # that the relocation below does not change get_name()/get_full_name().
+        state_name = cls.get_name()
+        setattr(reflex.istate.dynamic, state_name, cls)
+        # Preserve the original module for `reload_state_module` to key off
+        # of when evicting stale substates on hot reload. A dunder name is
+        # used deliberately so it is skipped by
+        # `types.is_backend_base_variable` and does not leak in as a
+        # backend var when this class is used as a mixin.
+        cls.__original_module__ = cls.__module__
+        cls.__module__ = reflex.istate.dynamic.__name__
+        cls.__qualname__ = state_name
+
