+#: The request parameters that are used to create the ``request.User`` object
+USER_PARAMETERS = ["user", "username", "realm", "resolver"]
+
+
+def update_request_user(request):
+    """
+    Recreate the ``request.User`` object from the (mangled) request parameters.
+
+    The ``request.User`` object is created in the ``before_request`` of the
+    blueprints, i.e. before the pre event handlers are run. So if a user
+    related parameter is modified, the user object needs to be updated,
+    otherwise the modification would have no effect.
+
+    :param request: The request object
+    """
+    if not hasattr(request, "User"):
+        # Some endpoints do not provide a user object at all
+        return
+    params = request.all_data
+    # The /auth endpoint uses "username", all other endpoints use "user"
+    login, realm = split_user(params.get("user") or params.get("username") or "")
+    realm = params.get("realm") or realm
+    if login and not realm:
+        realm = get_default_realm()
+    try:
+        request.User = User(login=login, realm=realm or "",
+                            resolver=params.get("resolver") or "")
+    except Exception as e:
+        log.warning("Failed to resolve the user {0!r} in realm {1!r}: "
+                    "{2!s}".format(login, realm, e))
+        request.User = User()
+
+
