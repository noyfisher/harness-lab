+# SPDX-FileCopyrightText: 2022-present deepset GmbH <info@deepset.ai>
+#
+# SPDX-License-Identifier: Apache-2.0
+
+from io import StringIO
+from typing import Any, Dict, List, Optional, Tuple
+
+import pandas as pd
+
+from haystack import Document, component, logging
+
+logger = logging.getLogger(__name__)
+
+
+@component
+class CSVDocumentSplitter:
+    """
+    A component for splitting CSV documents into sub-tables based on split arguments.
+
+    The splitter identifies consecutive empty rows or columns that exceed a given threshold
+    and uses them as delimiters to segment the document into smaller tables.
+    """
+
+    def __init__(
+        self,
+        row_split_threshold: Optional[int] = 2,
+        column_split_threshold: Optional[int] = 2,
+        read_csv_kwargs: Optional[Dict[str, Any]] = None,
+    ) -> None:
+        """
+        Initializes the CSVDocumentSplitter component.
+
+        :param row_split_threshold: The minimum number of consecutive empty rows required to trigger a split.
+        :param column_split_threshold: The minimum number of consecutive empty columns required to trigger a split.
+        :param read_csv_kwargs: Additional keyword arguments to pass to `pandas.read_csv`.
+            By default, the component uses the parameters `header=None`, `skip_blank_lines=False`, and
+            `dtype=object` in the `pandas.read_csv` call.
+        """
+        if row_split_threshold is not None and row_split_threshold < 1:
+            raise ValueError("row_split_threshold must be greater than 0")
+
+        if column_split_threshold is not None and column_split_threshold < 1:
+            raise ValueError("column_split_threshold must be greater than 0")
+
+        if row_split_threshold is None and column_split_threshold is None:
+            raise ValueError("At least one of row_split_threshold or column_split_threshold must be specified.")
+
+        self.row_split_threshold = row_split_threshold
+        self.column_split_threshold = column_split_threshold
+        self.read_csv_kwargs = read_csv_kwargs or {}
+
+    @component.output_types(documents=List[Document])
+    def run(self, documents: List[Document]) -> Dict[str, List[Document]]:
+        """
+        Processes and splits a list of CSV documents into multiple sub-tables.
+
+        **Splitting Strategy**
+
+        - If `row_split_threshold` is set, the document is split into sub-tables wherever there are at
+          least that many consecutive empty rows.
+        - If `column_split_threshold` is set, the document is split into sub-tables wherever there are at
+          least that many consecutive empty columns.
+        - If both thresholds are provided, the document is split recursively on rows first, then on columns.
+
+        :param documents: A list of Documents containing CSV-formatted content.
+
+        :returns:
+            A dictionary with a key `"documents"`, mapping to a list of new `Document` objects,
+            each representing a segmented part of the original CSV.
+        """
+        if len(documents) == 0:
+            return {"documents": documents}
+
+        split_documents = []
+        for document in documents:
+            try:
+                resolved_read_csv_kwargs = {
+                    "header": None,
+                    "skip_blank_lines": False,
+                    "dtype": object,
+                    **self.read_csv_kwargs,
+                }
+                df = pd.read_csv(StringIO(document.content), **resolved_read_csv_kwargs)  # type: ignore
+            except Exception as e:
+                logger.error(
+                    "Error processing document {doc_id}. Keeping it, but skipping splitting. Error: {error}",
+                    doc_id=document.id,
+                    error=e,
+                )
+                split_documents.append(document)
+                continue
+
+            if self.row_split_threshold is not None and self.column_split_threshold is None:
+                split_dfs = self._split_dataframe(df=df, split_threshold=self.row_split_threshold, axis="row")
+            elif self.row_split_threshold is None and self.column_split_threshold is not None:
+                split_dfs = self._split_dataframe(df=df, split_threshold=self.column_split_threshold, axis="column")
+            else:
+                split_dfs = self._recursive_split(
+                    df=df,
+                    row_split_threshold=self.row_split_threshold,
+                    column_split_threshold=self.column_split_threshold,
+                )
+
+            sorted_dfs = sorted(split_dfs, key=lambda sub_df: (sub_df.index[0], sub_df.columns[0]))
+
+            for split_id, split_df in enumerate(sorted_dfs):
+                split_documents.append(
+                    Document(
+                        content=split_df.to_csv(index=False, header=False, lineterminator="\n"),
+                        meta={
+                            **document.meta.copy(),
+                            "source_id": document.id,
+                            "row_idx_start": int(split_df.index[0]),
+                            "col_idx_start": int(split_df.columns[0]),
+                            "split_id": split_id,
+                        },
+                    )
+                )
+
+        return {"documents": split_documents}
+
+    @staticmethod
+    def _find_split_indices(df: "pd.DataFrame", split_threshold: int, axis: str) -> List[Tuple[int, int]]:
+        """
+        Finds the indices of consecutive empty rows or columns in a DataFrame that meet the split threshold.
+
+        :param df: DataFrame to split.
+        :param split_threshold: The minimum number of consecutive empty rows or columns required to trigger a split.
+        :param axis: The axis along which to find the split indices. Either "row" or "column".
+
+        :returns:
+            A list of tuples, where each tuple contains the positional (0-based) start and end offset of a run
+            of consecutive empty rows or columns that meets the split threshold.
+        """
+        empty_mask = (df.isnull().all(axis=0) if axis == "column" else df.isnull().all(axis=1)).to_numpy()
+        empty_elements = [idx for idx, is_empty in enumerate(empty_mask) if is_empty]
+
+        split_indices = []
+        consecutive_indices = []
+        for i, element in enumerate(empty_elements):
+            if i == 0 or element == empty_elements[i - 1] + 1:
+                consecutive_indices.append(element)
+            else:
+                if len(consecutive_indices) >= split_threshold:
+                    split_indices.append((consecutive_indices[0], consecutive_indices[-1]))
+                consecutive_indices = [element]
+
+        if len(consecutive_indices) >= split_threshold:
+            split_indices.append((consecutive_indices[0], consecutive_indices[-1]))
+
+        return split_indices
+
+    def _split_dataframe(
+        self, df: "pd.DataFrame", split_threshold: int, axis: str
+    ) -> List["pd.DataFrame"]:
+        """
+        Splits a DataFrame into sub-tables based on consecutive empty rows or columns exceeding `split_threshold`.
+
+        :param df: DataFrame to split.
+        :param split_threshold: The minimum number of consecutive empty rows or columns required to trigger a split.
+        :param axis: The axis along which to split. Either "row" or "column".
+
+        :returns:
+            A list of DataFrames, each representing a segmented part of the original CSV.
+        """
+        split_indices = self._find_split_indices(df=df, split_threshold=split_threshold, axis=axis)
+        if not split_indices:
+            return [df]
+
+        sub_tables = []
+        table_start_idx = 0
+        for empty_start, empty_end in split_indices:
+            if axis == "row":
+                if empty_start > table_start_idx:
+                    sub_table = df.iloc[table_start_idx:empty_start]
+                    if not sub_table.empty:
+                        sub_tables.append(sub_table)
+            else:
+                if empty_start > table_start_idx:
+                    sub_table = df.iloc[:, table_start_idx:empty_start]
+                    if not sub_table.empty:
+                        sub_tables.append(sub_table)
+            table_start_idx = empty_end + 1
+
+        if axis == "row":
+            sub_table = df.iloc[table_start_idx:]
+        else:
+            sub_table = df.iloc[:, table_start_idx:]
+        if not sub_table.empty:
+            sub_tables.append(sub_table)
+
+        return sub_tables
+
+    def _recursive_split(
+        self, df: "pd.DataFrame", row_split_threshold: Optional[int], column_split_threshold: Optional[int]
+    ) -> List["pd.DataFrame"]:
+        """
+        Recursively splits a DataFrame.
+
+        Splits by rows first, then columns, and repeats until no more splits are made.
+
+        :param df: The DataFrame to split.
+        :param row_split_threshold: The minimum number of consecutive empty rows required to trigger a split.
+        :param column_split_threshold: The minimum number of consecutive empty columns required to trigger a split.
+
+        :returns:
+            A list of DataFrames, each representing a segmented part of the original CSV.
+        """
+        # Row-wise split
+        row_split_dfs = self._split_dataframe(df=df, split_threshold=row_split_threshold, axis="row")
+
+        # Column-wise split for each resulting sub-table
+        final_tables = []
+        for row_split_df in row_split_dfs:
+            final_tables.extend(
+                self._split_dataframe(df=row_split_df, split_threshold=column_split_threshold, axis="column")
+            )
+
+        # If no further splitting occurred, return as is
+        if len(final_tables) == 1 and final_tables[0].equals(df):
+            return final_tables
+
+        # Recursively reapply splitting checked function to handle any remaining unsplit tables
+        result = []
+        for table in final_tables:
+            result.extend(self._recursive_split(table, row_split_threshold, column_split_threshold))
+
+        return result
