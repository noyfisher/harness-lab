+_cell_magic_assign_re = re.compile(r"^(?P<lhs>\s*[a-zA-Z_]\w*\s*=\s*)(?=%%)")
+
+
+def _find_cell_magic(line):
+    """If *line* is a (possibly assigned) cell magic, return (lhs, rest).
+
+    ``lhs`` is the assignment prefix (empty string if there is none) and
+    ``rest`` is the remainder of the line starting at the ``%%``. Returns
+    None if the line is not a cell magic at all.
+    """
+    m = _cell_magic_assign_re.match(line)
+    if m:
+        return m.group('lhs'), line[m.end():]
+    if line.startswith('%%'):
+        return '', line
+    return None
+
