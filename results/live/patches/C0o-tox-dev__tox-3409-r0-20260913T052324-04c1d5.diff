@@ -856,6 +856,33 @@ Python run
             -r requirements.txt
             -c constraints.txt
 
+.. conf::
+   :keys: dependency_groups
+   :default: <empty list>
+   :version_added: 4.22
+
+   The :pep:`735` dependency groups to install, loaded from the ``[dependency-groups]`` table of the ``pyproject.toml``
+   file found within :ref:`package_root` (falling back to :ref:`tox_root`). Installed into the environment prior to the
+   project after environment creation, but before package installation.
+
+   For example:
+    .. tab:: TOML
+
+       .. code-block:: toml
+
+          [tool.pyproject.env_run_base]
+          dependency_groups = [
+            "test",
+          ]
+
+    .. tab:: INI
+
+       .. code-block:: ini
+
+        [testenv]
+        dependency_groups =
+            test
+
 .. conf::
    :keys: use_develop, usedevelop
    :default: false
