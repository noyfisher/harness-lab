+def _normalize_extras(values: set[str]) -> set[str]:
+    # although _ and . is allowed this will be normalized during packaging to -
+    # https://packaging.python.org/en/latest/specifications/dependency-specifiers/#grammar
+    return {canonicalize_name(v) for v in values}
+
+
+def dependency_groups(root: Path, groups: set[str]) -> set[Requirement]:
+    """
+    Load a set of :pep:`735` dependency groups from the ``pyproject.toml`` file found at ``root``.
+
+    :param root: the folder containing the ``pyproject.toml`` file
+    :param groups: the dependency groups to resolve
+    :return: the requirements of the (transitively) included groups
+    """
+    pyproject_file = root / "pyproject.toml"
+    if not pyproject_file.exists():  # check if it's static PEP-621 metadata
+        msg = f"could not find {pyproject_file} to load dependency groups from"
+        raise HandledError(msg)
+    with pyproject_file.open("rb") as file_handler:
+        pyproject = tomllib.load(file_handler)
+    raw_groups = pyproject.get("dependency-groups", {})
+    if not isinstance(raw_groups, dict):
+        msg = f"dependency-groups table in {pyproject_file} is {type(raw_groups).__name__} instead of table"
+        raise HandledError(msg)
+    normalized: dict[str, Any] = {canonicalize_name(k): v for k, v in raw_groups.items()}
+    result: set[Requirement] = set()
+    for group in groups:
+        result.update(_resolve_dependency_group(pyproject_file, normalized, canonicalize_name(group)))
+    return result
+
+
+def _resolve_dependency_group(
+    pyproject_file: Path,
+    groups: Mapping[str, Any],
+    group: str,
+    past_groups: tuple[str, ...] = (),
+) -> set[Requirement]:
+    if group in past_groups:
+        msg = f"cyclic dependency group include in {pyproject_file}: {' -> '.join((*past_groups, group))}"
+        raise HandledError(msg)
+    if group not in groups:
+        msg = f"dependency group {group!r} not found in {pyproject_file}"
+        raise HandledError(msg)
+    raw_group = groups[group]
+    if not isinstance(raw_group, list):
+        msg = f"dependency group {group!r} in {pyproject_file} is not a list"
+        raise HandledError(msg)
+
+    result: set[Requirement] = set()
+    for item in raw_group:
+        if isinstance(item, str):
+            try:
+                result.add(Requirement(item))
+            except InvalidRequirement as exc:
+                msg = f"{item!r} is not valid requirement due to {exc}"
+                raise HandledError(msg) from exc
+        elif isinstance(item, dict) and tuple(item.keys()) == ("include-group",):
+            include_group = canonicalize_name(next(iter(item.values())))
+            result.update(_resolve_dependency_group(pyproject_file, groups, include_group, (*past_groups, group)))
+        else:
+            msg = f"invalid dependency group item in {pyproject_file}: {item!r}"
+            raise HandledError(msg)
+    return result
 
+
