         self.default = default
         self.dev = dev
-        self.excluded_groups = excluded_groups
+        self._excluded_groups = excluded_groups
+
+    @cached_property
+    def _group_lookup(self) -> dict[str, str]:
+        """Map normalized group names to the project's actual group names.
+
+        Computed lazily (rather than in ``__init__``) because the pyproject
+        can be mutated between constructing a ``GroupSelection`` and reading
+        it (e.g. ``pdm add``).
+        """
+        return {normalize_name(g): g for g in self.project.iter_groups()}
+
+    def _resolve_group(self, name: str) -> str:
+        """Resolve a user-supplied group name to the project's actual group name.
+
+        ``:all`` and other ``:xxx`` markers are left untouched. Names that
+        don't match any project group are returned unchanged so the existing
+        "Ignoring non-existing groups" handling still applies.
+        """
+        if name.startswith(":"):
+            return name
+        return self._group_lookup.get(normalize_name(name), name)
+
+    @property
+    def groups(self) -> list[str]:
+        return [self._resolve_group(g) for g in self._groups]
+
+    @property
+    def group(self) -> str | None:
+        return self._resolve_group(self._group) if self._group else self._group
+
+    @property
+    def excluded_groups(self) -> list[str]:
+        return [self._resolve_group(g) for g in self._excluded_groups]
 
