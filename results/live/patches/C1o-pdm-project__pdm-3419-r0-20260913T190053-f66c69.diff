     return realized_group, referred_groups
 
 
+def _iter_included_groups(
+    dependency_groups: dict[str, list[Any]], group: str, past_groups: tuple[str, ...] = ()
+) -> Iterable[str]:
+    for item in dependency_groups.get(group, []):
+        if isinstance(item, dict) and tuple(item.keys()) == ("include-group",):
+            included = normalize_name(next(iter(item.values())))
+            if included in past_groups or included == group:
+                continue
+            yield included
+            yield from _iter_included_groups(dependency_groups, included, (*past_groups, group))
+
