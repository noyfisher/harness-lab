+        result = {group: self.get_dependencies(group, resolve_include=False) for group in self.iter_groups()}
+        # `include-group` items are not expanded above, so the requirements of an included group
+        # must inherit the name of the group including them, otherwise the group metadata would be
+        # lost when the result is fed to the locking process.
+        normalized = {normalize_name(group): deps for group, deps in result.items()}
