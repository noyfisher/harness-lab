@@ -0,0 +1,78 @@
+"""Support for PEP-735 dependency groups."""
+
+from __future__ import annotations
+
+import sys
+from typing import TYPE_CHECKING, Any, Mapping
+
+from packaging.requirements import InvalidRequirement, Requirement
+from packaging.utils import canonicalize_name
+
+from tox.report import HandledError
+
+if sys.version_info >= (3, 11):  # pragma: >=3.11 cover
+    import tomllib
+else:  # pragma: <3.11 cover
+    import tomli as tomllib
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+
+def resolve(root: Path, groups: set[str]) -> set[Requirement]:
+    """resolve the dependency groups from the pyproject.toml at root"""
+    pyproject_toml = root / "pyproject.toml"
+    if not pyproject_toml.exists():
+        msg = f"{pyproject_toml} does not exist, cannot resolve dependency groups"
+        raise HandledError(msg)
+    with pyproject_toml.open("rb") as file_handler:
+        pyproject = tomllib.load(file_handler)
+    dependency_groups = pyproject.get("dependency-groups", {})
+    if not isinstance(dependency_groups, Mapping):
+        msg = f"dependency-groups table in {pyproject_toml} is not a table"
+        raise HandledError(msg)
+    dependency_groups = {canonicalize_name(k): v for k, v in dependency_groups.items()}
+    result: set[Requirement] = set()
+    for group in groups:
+        result.update(_resolve_dependency_group(dependency_groups, canonicalize_name(group)))
+    return result
+
+
+def _resolve_dependency_group(
+    dependency_groups: Mapping[str, Any], group: str, past_groups: tuple[str, ...] = ()
+) -> tuple[Requirement, ...]:
+    if group in past_groups:
+        msg = f"Cyclic dependency group include: {group!r}"
+        raise HandledError(msg)
+    if group not in dependency_groups:
+        msg = f"Dependency group {group!r} not found"
+        raise HandledError(msg)
+
+    raw_group = dependency_groups[group]
+    if not isinstance(raw_group, list):
+        msg = f"Dependency group {group!r} is not a list"
+        raise HandledError(msg)
+
+    result: list[Requirement] = []
+    for item in raw_group:
+        if isinstance(item, str):
+            try:
+                result.append(Requirement(item))
+            except InvalidRequirement as exc:
+                msg = f"Dependency group {group!r} contains invalid requirement {item!r}: {exc}"
+                raise HandledError(msg) from exc
+        elif isinstance(item, dict):
+            if tuple(item.keys()) != ("include-group",):
+                msg = f"Dependency group {group!r} contains invalid item: {item!r}"
+                raise HandledError(msg)
+            include_group = canonicalize_name(item["include-group"])
+            result.extend(_resolve_dependency_group(dependency_groups, include_group, (*past_groups, group)))
+        else:
+            msg = f"Dependency group {group!r} contains invalid item: {item!r}"
+            raise HandledError(msg)
+    return tuple(result)
+
+
+__all__ = [
+    "resolve",
+]
