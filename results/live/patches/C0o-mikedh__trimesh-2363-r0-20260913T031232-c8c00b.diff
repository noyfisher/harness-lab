+def _svg_number(value, default=0.0):
+    """
+    Parse an SVG attribute into a float, discarding any unit suffix.
+
+    Parameters
+    ------------
+    value : None or str
+      Something like "10" or "1.5mm"
+    default : float
+      Returned if the value can't be parsed.
+
+    Returns
+    ------------
+    number : float
+      The parsed value.
+    """
