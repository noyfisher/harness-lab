--- a/haystack/components/converters/utils.py
+++ b/haystack/components/converters/utils.py
@@ -5,7 +5,14 @@
 from pathlib import Path
 from typing import Any, Dict, List, Optional, Union
 
+from haystack import logging
 from haystack.dataclasses import ByteStream
+from haystack.lazy_imports import LazyImport
+
+with LazyImport("Run 'pip install chardet'") as chardet_import:
+    import chardet
+
+logger = logging.getLogger(__name__)
 
 
 def get_bytestream_from_source(source: Union[str, Path, ByteStream]) -> ByteStream:
@@ -49,3 +56,41 @@ def normalize_metadata(
             raise ValueError("The length of the metadata list must match the number of sources.")
         return meta
     raise ValueError("meta must be either None, a dictionary or a list of dictionaries.")
+
+
+def decode_text_with_encoding(text: str, encoding: str = "utf-8") -> str:
+    """
+    Re-decodes text that a PDF library may have decoded with the wrong codec.
+
+    :param text:
+        The text extracted by the PDF library.
+    :param encoding:
+        The encoding to use to re-decode the text. Use `"utf-8"` (the default) to leave the text unchanged,
+        a codec name (e.g. `"cp1252"`) to decode with that codec, or `"auto"` to detect the codec with chardet.
+    :returns:
+        The re-decoded text, or the original text if it doesn't need to be, or can't be, re-decoded.
+    """
+    if not text or encoding.lower() in ("utf-8", "utf8"):
+        return text
+
+    try:
+        raw = text.encode("latin-1")
+    except UnicodeEncodeError:
+        # The text contains characters outside latin-1, so it was decoded correctly already.
+        return text
+
+    resolved_encoding = encoding
+    if encoding == "auto":
+        chardet_import.check()
+        detected = chardet.detect(raw)["encoding"]
+        if detected is None:
+            return text
+        resolved_encoding = detected
+
+    try:
+        return raw.decode(resolved_encoding)
+    except (UnicodeDecodeError, LookupError):
+        logger.warning(
+            "Could not decode text with encoding {encoding}. Returning the original text.", encoding=encoding
+        )
+        return text
