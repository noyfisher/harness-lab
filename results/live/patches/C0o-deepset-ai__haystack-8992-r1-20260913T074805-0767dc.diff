+def reencode_text(text: str, encoding: str) -> str:
+    """
+    Converts text extracted from a document to UTF-8 using an explicit source encoding.
+
+    PDF parsers map the raw bytes of a file to characters one by one when the file does not carry
+    reliable encoding information. If those bytes are not UTF-8 (for example ANSI or cp1252), the
+    resulting string is garbled. This function maps the characters back to the original bytes and
+    decodes them with the given encoding.
+
+    :param text: The text to convert.
+    :param encoding: The encoding of the original bytes. "utf-8" leaves the text unchanged.
+    :returns: The converted text, or the original text if it cannot be converted.
+    """
+    if not text:
+        return text
+    try:
+        if codecs.lookup(encoding).name == "utf-8":
+            return text
+        return text.encode("latin-1", errors="ignore").decode(encoding, errors="replace")
+    except (LookupError, UnicodeDecodeError):
+        return text
+
