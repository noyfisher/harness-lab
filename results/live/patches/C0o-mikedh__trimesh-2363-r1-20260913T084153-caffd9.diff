+def _attrib_to_float(attrib, key, default=0.0):
+    """
+    Get a single attribute from an SVG element as a float,
+    ignoring any unit suffix, i.e. "10mm" -> 10.0
+
+    Parameters
+    ------------
+    attrib : dict
+      Attributes of an SVG element.
+    key : str
+      The attribute to retrieve.
+    default : float
+      Value to return if the key is missing or unparseable.
+
+    Returns
+    ------------
+    value : float
+      The value of the attribute.
+    """
+    raw = attrib.get(key)
+    if raw is None:
+        return default
+    try:
+        return float(raw)
+    except ValueError:
+        pass
+    # strip off any trailing unit, i.e. "10mm" or "50%"
+    trim = raw.strip().rstrip("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ%")
+    try:
+        return float(trim)
+    except ValueError:
+        return default
+
