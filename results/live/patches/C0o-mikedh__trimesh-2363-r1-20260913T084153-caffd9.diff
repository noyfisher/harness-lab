+def _shape_to_path_string(tag, attrib):
+    """
+    Convert one of the SVG basic shapes into an equivalent
+    SVG path string, i.e. the value of a `path` element's `d`.
+
+    Parameters
+    ------------
+    tag : str
+      The name of the element without a namespace,
+      i.e. `rect` or `circle`.
+    attrib : dict
+      Attributes of the SVG element.
+
+    Returns
+    ------------
+    path_string : str
+      A path string which may be empty if the
+      element has no usable geometry.
+    """
+    if tag == "rect":
+        width = _attrib_to_float(attrib, "width")
+        height = _attrib_to_float(attrib, "height")
+        if width <= 0.0 or height <= 0.0:
+            return ""
+        x = _attrib_to_float(attrib, "x")
+        y = _attrib_to_float(attrib, "y")
+        # corner radii default to each other and are clipped to half the side
+        rx = _attrib_to_float(attrib, "rx", _attrib_to_float(attrib, "ry"))
+        ry = _attrib_to_float(attrib, "ry", rx)
+        rx, ry = min(abs(rx), width / 2.0), min(abs(ry), height / 2.0)
+        if rx <= 0.0 or ry <= 0.0:
+            # a simple rectangle from four lines
+            return f"M{x},{y}H{x + width}V{y + height}H{x}Z"
+        # a rounded rectangle alternating lines and corner arcs
+        arc = f"A{rx},{ry} 0 0 1 "
+        return (
+            f"M{x + rx},{y}H{x + width - rx}{arc}{x + width},{y + ry}"
+            + f"V{y + height - ry}{arc}{x + width - rx},{y + height}"
+            + f"H{x + rx}{arc}{x},{y + height - ry}"
+            + f"V{y + ry}{arc}{x + rx},{y}Z"
+        )
+    elif tag in ("circle", "ellipse"):
+        cx = _attrib_to_float(attrib, "cx")
+        cy = _attrib_to_float(attrib, "cy")
+        if tag == "circle":
+            rx = _attrib_to_float(attrib, "r")
+            ry = rx
+        else:
+            rx = _attrib_to_float(attrib, "rx", _attrib_to_float(attrib, "ry"))
+            ry = _attrib_to_float(attrib, "ry", rx)
+        if rx <= 0.0 or ry <= 0.0:
+            return ""
+        if abs(rx - ry) < 1e-8:
+            # a circle as two arc segments which will be
+            # recombined into a single closed arc entity
+            return (
+                f"M{cx - rx},{cy}a{rx},{rx} 0 1 0 {2.0 * rx},0"
+                + f"a{rx},{rx} 0 1 0 {-2.0 * rx},0Z"
+            )
+        # an ellipse can't be represented by trimesh arcs so
+        # use the usual four cubic bezier approximation
+        k = 0.5522847498307933
+        return (
+            f"M{cx + rx},{cy}"
+            + f"C{cx + rx},{cy + k * ry} {cx + k * rx},{cy + ry} {cx},{cy + ry}"
+            + f"C{cx - k * rx},{cy + ry} {cx - rx},{cy + k * ry} {cx - rx},{cy}"
+            + f"C{cx - rx},{cy - k * ry} {cx - k * rx},{cy - ry} {cx},{cy - ry}"
+            + f"C{cx + k * rx},{cy - ry} {cx + rx},{cy - k * ry} {cx + rx},{cy}Z"
+        )
+    elif tag == "line":
+        x1 = _attrib_to_float(attrib, "x1")
+        y1 = _attrib_to_float(attrib, "y1")
+        x2 = _attrib_to_float(attrib, "x2")
+        y2 = _attrib_to_float(attrib, "y2")
+        return f"M{x1},{y1}L{x2},{y2}"
+    elif tag in ("polyline", "polygon"):
+        try:
+            values = [
+                float(i) for i in attrib.get("points", "").replace(",", " ").split()
+            ]
+        except ValueError:
+            log.debug("failed to parse points", exc_info=True)
+            return ""
+        if len(values) < 4:
+            return ""
+        # an even number of values are required
+        points = np.array(values[: (len(values) // 2) * 2]).reshape((-1, 2))
+        path_string = "M" + "L".join(f"{x},{y}" for x, y in points)
+        if tag == "polygon":
+            # polygons are implicitly closed
+            path_string += "Z"
+        return path_string
+
+    return ""
+
